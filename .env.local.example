# =============================================================================
# Meridian Engagement AI — Environment Variables
# Copy this file to .env.local and fill in the values.
# All keys marked REQUIRED must be set before first deploy.
# =============================================================================

# -------- Supabase (REQUIRED) --------
# Get from https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGc...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...   # never expose to client
SUPABASE_PROJECT_ID=YOUR_PROJECT_REF    # for db:types script

# -------- Anthropic (REQUIRED) --------
# Get from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL_BRAIN=claude-sonnet-4-6
ANTHROPIC_MODEL_CHEAP=claude-haiku-4-5-20251001

# -------- OpenAI Embeddings (REQUIRED) --------
# Used ONLY for embeddings (text-embedding-3-small). ~$0.02/1M tokens.
# Get from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# -------- ManyChat (REQUIRED) --------
# Per-account API keys live in DB (manychat_accounts table).
# This is the global webhook signing secret you set in ManyChat External Request settings.
MANYCHAT_WEBHOOK_SECRET=your-long-random-secret-here
# Optional ManyChat tag name to apply on AI handoff. Must already exist in ManyChat.
MANYCHAT_HANDOFF_TAG=

# Optional abuse/spend guard. Incoming user messages above this per active conversation per minute are ignored.
RATE_LIMIT_MESSAGES_PER_MINUTE=30

# -------- OCR (OPTIONAL — scanned PDF ingestion) --------
# If pdf-parse extracts no text from a scanned PDF, the upload route calls this service.
# Contract: POST JSON { filename, mime_type, file_base64 } → { text }.
OCR_HTTP_ENDPOINT=
OCR_HTTP_TOKEN=

# -------- Telegram (OPTIONAL — handoff alerts) --------
# Create bot via @BotFather, get token. Add bot to ops group, get chat_id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OPS_CHAT_ID=

# -------- Cron Authentication (REQUIRED for prod) --------
# Random secret; Vercel Cron sends it in Authorization header.
CRON_SECRET=your-long-random-cron-secret

# -------- Internal API Authentication (REQUIRED for prod) --------
# Separate from CRON_SECRET; used only for server-to-server webhook → /api/chat calls.
INTERNAL_API_SECRET=your-long-random-internal-api-secret

# -------- App URL (REQUIRED) --------
# Used in landing-link UTMs and auth redirects.
NEXT_PUBLIC_APP_URL=https://meridian-engagement-ai.vercel.app
NEXT_PUBLIC_LANDING_BASE_URL=https://trademeridian.co

# Optional internal base URL for server-to-server calls.
# Use http://localhost:3000 when testing ManyChat through ngrok locally.
INTERNAL_APP_URL=

# Optional reply timing humanization. Set to false in tests to disable typing delay.
HUMANIZE_TIMING=true

# Upstash Redis (rate limiting) — optional; if unset, rate limiting is skipped.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional local verification marker. Leave blank in production.
REPLY_DEBUG_SUFFIX=

# Optional callback booking URL. If empty, callback requests become human handoffs.
CALLBACK_BOOKING_URL=

# -------- Default brand (OPTIONAL — seeding convenience) --------
DEFAULT_BRAND_SLUG=meridian
